{
  "name": "lostman",
  "productName": "Lostman",
  "version": "1.6.1",
  "description": "Lostman",
  "keywords": [
    "api-client",
    "rest-client",
    "http-client",
    "postman-alternative",
    "api-testing",
    "graphql",
    "websocket",
    "sse",
    "curl",
    "openapi",
    "swagger",
    "electron",
    "developer-tools",
    "offline"
  ],
  "author": "Ali Hammoud <alihammoud995@gmail.com>",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "lint": "eslint src test vscode",
    "format": "prettier --write src test",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --linux"
  },
  "build": {
    "appId": "com.lostman.app",
    "productName": "Lostman",
    "publish": {
      "provider": "github",
      "owner": "AliHammoud995",
      "repo": "lostman"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Free, offline API client",
      "description": "A free, offline API client. No login, no cloud — just requests.",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
